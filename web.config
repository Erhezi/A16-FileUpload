<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appSettings>
    <add key="WSGI_HANDLER" value="run.app" />
    <!-- Relative to the folder IIS points at. The app pool must be able to write there, or
         every request answers 500. -->
    <add key="WSGI_LOG" value="logs\wfastcgi.log" />
    <!-- wfastcgi sets these before the app loads and .env cannot override them, so a copied
         development .env cannot turn on the development auth bypass on the server. -->
    <add key="FILEUPLOAD_ENVIRONMENT" value="production" />
    <add key="FILEUPLOAD_URL_PREFIX" value="/fileupload" />
  </appSettings>
  <system.webServer>
    <handlers>
      <!-- Drops handlers inherited from the server, so every request reaches the app. -->
      <clear />
      <!-- The only fixed path in this file. set_server_path.py replaces it with the real folder,
           and it must match what wfastcgi-enable registered, character for character. -->
      <add name="Python FastCGI"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="D:\FileUpload\A16-FileUpload\.venv\Scripts\python.exe|D:\FileUpload\A16-FileUpload\.venv\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>
    <security>
      <requestFiltering>
        <!-- 50 MB, matching FILEUPLOAD_MAX_UPLOAD_MB. The IIS default is about 28.6 MB. -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
