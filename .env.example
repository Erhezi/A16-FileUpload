# Copy to .env. Everything not listed here has a working default in app/config.py.
# Every name starts with FILEUPLOAD_, so variables set for other apps never apply here.

# production (default when unset) or development.
# On IIS, web.config sets this and FILEUPLOAD_URL_PREFIX, and those values win over this file.
FILEUPLOAD_ENVIRONMENT=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FILEUPLOAD_SECRET_KEY=

# URL prefix for local runs.
FILEUPLOAD_URL_PREFIX=/fileupload

# Development only. Loading writes to the production PBI database because there
# is no test copy, so it stays off locally unless this is set to true.
# FILEUPLOAD_WAVE_REFRESH_ENABLED=true

# The app's own tables: users, roles, activity log and ETL health.
# FILEUPLOAD_LOG_DB_SERVER=
# FILEUPLOAD_LOG_DB_NAME=SCSFileIngestor
